# Copy to .env and fill in. .env is never committed and never pasted into chat.
# Testnet only. Never put a key that holds real funds here.

# ---- 0G (Galileo testnet, chain ID 16602) ----
# Private Computer API key, from pc.0g.ai (team credits are handed out at the event)
ZG_PC_API_KEY=
ZG_PC_BASE_URL=https://router-api.0g.ai/v1
# Wallet that pays for 0G Storage uploads and deploys the episode-root contract
# Fund at https://faucet.0g.ai (0.1 0G per wallet per day)
ZG_PRIVATE_KEY=
ZG_EVM_RPC=https://evmrpc-testnet.0g.ai
ZG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai

# ---- Hedera (testnet) ----
# Agent that pays (account from portal.hedera.com, ECDSA key)
HEDERA_PAYER_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# Merchant that receives (the payTo account; can be created from the payer account by code)
HEDERA_MERCHANT_ACCOUNT_ID=
HEDERA_MERCHANT_PRIVATE_KEY=
# Facilitator: no API key needed (docs.hedera.com, facilitators page)
X402_FACILITATOR_URL=https://x402.org/facilitator

# ---- Arkiv (Rabdi testnet, network ID 7794095) ----
# Free access key from https://hub.arkiv.network/access-keys (public RPC is heavily rate limited without it)
ARKIV_ACCESS_KEY=
# One wallet per receiver, so each receiver owns its entities. Fund with tGLM at https://hub.arkiv.network/faucet
ARKIV_GROUND_PRIVATE_KEY=
ARKIV_SIM_RX1_PRIVATE_KEY=
ARKIV_SIM_RX2_PRIVATE_KEY=
